    </ExtensionList>
    <ExecutionEnvironment>
        <HostList><Host Name="PPRO" Version="11.0" /></HostList>
        <LocaleList><Locale Code="All" /></LocaleList>
        <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="6.0" /></RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
